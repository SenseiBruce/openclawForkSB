OPENCLAW_GEMINI_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# OTLP collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTLP protocol
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTLP service name
OTEL_SERVICE_NAME=openclaw

# -----------------------------------------------------------------------------
# Browser / Playwright
# -----------------------------------------------------------------------------
# Path to Chrome/Chromium
BROWSER_EXECUTABLE_PATH=
# OpenClaw browser executable override
OPENCLAW_BROWSER_EXECUTABLE_PATH=
# Playwright Chromium path
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Optional browser-control module override
OPENCLAW_BROWSER_CONTROL_MODULE=
# Skip starting the browser control server
OPENCLAW_SKIP_BROWSER_CONTROL_SERVER=0

# -----------------------------------------------------------------------------
# Tunneling / networking
# -----------------------------------------------------------------------------
# ngrok auth token
NGROK_AUTHTOKEN=
# Reserved ngrok domain
NGROK_DOMAIN=
# HTTP proxy URL
HTTP_PROXY=
# HTTPS proxy URL
HTTPS_PROXY=
# Proxy bypass list
NO_PROXY=localhost,127.0.0.1
# SSH port used by remote helpers
OPENCLAW_SSH_PORT=22

