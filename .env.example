COPILOT_GITHUB_TOKEN=
# GitHub token for Copilot/API access
GITHUB_TOKEN=
# GCP project for Vertex/Gemini
GOOGLE_CLOUD_PROJECT=
# GCP project id alias
GOOGLE_CLOUD_PROJECT_ID=

# -----------------------------------------------------------------------------
