# OpenClaw .env example
#
# Quick start:
# 1) Copy this file to `.env` (for local runs from this repo), OR to `~/.openclaw/.env` (for launchd/systemd daemons).
# 2) Fill only the values you use. Empty values are ignored.
# 3) Keep real secrets out of git.
#
# Env-source precedence (highest -> lowest):
# process env, ./.env, ~/.openclaw/.env, then openclaw.json `env` block.
# Existing non-empty process env vars are not overridden by dotenv/config env loading.
#
# This file lists the environment variables referenced by src/ and extensions/.
# Direct config keys (for example gateway.auth.token) are resolved separately.

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
# Gateway bearer token when binding beyond loopback
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Optional password auth instead of token
OPENCLAW_GATEWAY_PASSWORD=change-me-to-a-strong-password
# Gateway listen port
OPENCLAW_GATEWAY_PORT=18789
# Client URL for the gateway websocket
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# Bind mode: loopback, lan, or tailnet
OPENCLAW_GATEWAY_BIND=lan
# Allow insecure private websocket (dev only)
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=0
# Persistent state directory
OPENCLAW_STATE_DIR=~/.openclaw
# Path to openclaw.json
OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
# Override home used to resolve default paths
OPENCLAW_HOME=~
# Named config profile
OPENCLAW_PROFILE=default
# Import missing keys from the login shell
OPENCLAW_LOAD_SHELL_ENV=0
# Timeout for shell env import
OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000
# Structured log level (trace/debug/info/warn/error/silent)
OPENCLAW_LOG_LEVEL=info
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=
# Sentry traces sample rate (0-1)
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Model provider API keys
# -----------------------------------------------------------------------------
# OpenAI API key
OPENAI_API_KEY=sk-your-openai-key
# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
