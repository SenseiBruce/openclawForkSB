SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Slack app-level token
SLACK_APP_TOKEN=xapp-your-slack-app-token
# Slack user token
SLACK_USER_TOKEN=xoxp-your-slack-user-token
# Slack bot user id
SLACK_BOT_USER_ID=
# Optional Slack event forwarder URL
SLACK_FORWARDER_URL=
# Mattermost bot token
MATTERMOST_BOT_TOKEN=your-mattermost-token
# Mattermost server URL
MATTERMOST_URL=https://chat.example.com
# Zalo bot token
ZALO_BOT_TOKEN=your-zalo-bot-token
# zalouser profile path
ZALOUSER_PROFILE=
# ZCA profile path alias
ZCA_PROFILE=
# Twitch IRC oauth token
OPENCLAW_TWITCH_ACCESS_TOKEN=oauth:your-twitch-token
# LINE channel access token
LINE_CHANNEL_ACCESS_TOKEN=your-line-token
# LINE channel secret
LINE_CHANNEL_SECRET=your-line-secret
# Matrix homeserver URL
MATRIX_HOMESERVER=https://matrix.example.com
# Matrix user id
MATRIX_USER_ID=@bot:example.com
# Matrix access token
MATRIX_ACCESS_TOKEN=your-matrix-access-token
# Matrix password (if not using token)
MATRIX_PASSWORD=your-matrix-password
# Feishu/Lark app id
FEISHU_APP_ID=cli_your-feishu-app-id
# Feishu/Lark app secret
FEISHU_APP_SECRET=your-feishu-app-secret
# Microsoft Teams app id
MSTEAMS_APP_ID=your-msteams-app-id
# Microsoft Teams app password
MSTEAMS_APP_PASSWORD=your-msteams-app-password
# Microsoft Teams tenant id
MSTEAMS_TENANT_ID=your-msteams-tenant-id
# Nextcloud Talk bot secret
NEXTCLOUD_TALK_BOT_SECRET=your-nextcloud-talk-secret
# Synology Chat incoming token
SYNOLOGY_CHAT_TOKEN=your-synology-chat-token
# Synology Chat incoming URL
SYNOLOGY_CHAT_INCOMING_URL=https://nas.example.com/webapi/entry.cgi
# Synology NAS hostname
SYNOLOGY_NAS_HOST=nas.example.com
# Comma-separated Synology Chat user allowlist
SYNOLOGY_ALLOWED_USER_IDS=
# Synology Chat rate limit
SYNOLOGY_RATE_LIMIT=
# IRC server host
IRC_HOST=irc.example.com
# IRC server port
IRC_PORT=6697
# Use TLS for IRC
IRC_TLS=1
# IRC nick
IRC_NICK=openclaw
# IRC username
IRC_USERNAME=openclaw
# IRC realname
IRC_REALNAME=OpenClaw
# IRC server password
IRC_PASSWORD=
# Comma-separated IRC channels
IRC_CHANNELS=#openclaw
# NickServ password
IRC_NICKSERV_PASSWORD=
# NickServ registration email
IRC_NICKSERV_REGISTER_EMAIL=

# -----------------------------------------------------------------------------
# Voice, media, and search tools
# -----------------------------------------------------------------------------
# ElevenLabs TTS API key
ELEVENLABS_API_KEY=your-elevenlabs-key
# ElevenLabs API key alias
XI_API_KEY=your-elevenlabs-key
# Deepgram STT API key
DEEPGRAM_API_KEY=your-deepgram-key
# Brave Search API key
BRAVE_API_KEY=your-brave-search-key
# Perplexity API key
PERPLEXITY_API_KEY=pplx-your-key
# Firecrawl API key
FIRECRAWL_API_KEY=fc-your-key
# Optional OpenAI-compatible TTS base URL
OPENAI_TTS_BASE_URL=
# Path to a whisper.cpp model
WHISPER_CPP_MODEL=
# Path to sherpa-onnx models
SHERPA_ONNX_MODEL_DIR=
# JSON blob of TTS preferences
OPENCLAW_TTS_PREFS=

# -----------------------------------------------------------------------------
# Voice call providers
# -----------------------------------------------------------------------------
# Twilio account SID
TWILIO_ACCOUNT_SID=ACxxxxxxxx
# Twilio auth token
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Telnyx API key
TELNYX_API_KEY=your-telnyx-key
# Telnyx connection id
TELNYX_CONNECTION_ID=
# Telnyx public key
TELNYX_PUBLIC_KEY=
# Plivo auth id
PLIVO_AUTH_ID=
# Plivo auth token
PLIVO_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# OAuth / CLI providers
# -----------------------------------------------------------------------------
# Chutes OAuth client id
CHUTES_CLIENT_ID=
# Chutes OAuth client secret
CHUTES_CLIENT_SECRET=
# Chutes OAuth redirect URI
CHUTES_OAUTH_REDIRECT_URI=
# Chutes OAuth scopes
CHUTES_OAUTH_SCOPES=
# Claude.ai session key (web provider)
CLAUDE_AI_SESSION_KEY=
# Claude web session key
CLAUDE_WEB_SESSION_KEY=
# Claude web cookie header
CLAUDE_WEB_COOKIE=
# Gemini CLI OAuth client id
OPENCLAW_GEMINI_OAUTH_CLIENT_ID=
# Gemini CLI OAuth client secret
OPENCLAW_GEMINI_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# OTLP collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTLP protocol
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTLP service name
OTEL_SERVICE_NAME=openclaw

# -----------------------------------------------------------------------------
# Browser / Playwright
# -----------------------------------------------------------------------------
# Path to Chrome/Chromium
BROWSER_EXECUTABLE_PATH=
# OpenClaw browser executable override
OPENCLAW_BROWSER_EXECUTABLE_PATH=
# Playwright Chromium path
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Optional browser-control module override
OPENCLAW_BROWSER_CONTROL_MODULE=
# Skip starting the browser control server
OPENCLAW_SKIP_BROWSER_CONTROL_SERVER=0

# -----------------------------------------------------------------------------
# Tunneling / networking
# -----------------------------------------------------------------------------
# ngrok auth token
NGROK_AUTHTOKEN=
# Reserved ngrok domain
NGROK_DOMAIN=
# HTTP proxy URL
HTTP_PROXY=
# HTTPS proxy URL
HTTPS_PROXY=
# Proxy bypass list
NO_PROXY=localhost,127.0.0.1
# SSH port used by remote helpers
OPENCLAW_SSH_PORT=22

# -----------------------------------------------------------------------------
# Legacy CLAWDBOT_ aliases
# -----------------------------------------------------------------------------
# Legacy alias for OPENCLAW_GATEWAY_TOKEN
CLAWDBOT_GATEWAY_TOKEN=
# Legacy alias for OPENCLAW_GATEWAY_PASSWORD
CLAWDBOT_GATEWAY_PASSWORD=
# Legacy alias for OPENCLAW_GATEWAY_PORT
CLAWDBOT_GATEWAY_PORT=
# Legacy alias for OPENCLAW_GATEWAY_URL
CLAWDBOT_GATEWAY_URL=
# Legacy alias for OPENCLAW_STATE_DIR
CLAWDBOT_STATE_DIR=
# Legacy alias for OPENCLAW_MDNS_HOSTNAME
CLAWDBOT_MDNS_HOSTNAME=
# Legacy alias for OPENCLAW_SHELL
CLAWDBOT_SHELL=
# Legacy show-secrets flag
CLAWDBOT_SHOW_SECRETS=0

